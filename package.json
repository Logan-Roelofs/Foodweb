{
  "name": "foodweb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "emulators": "firebase emulators:start --project demo-foodweb --import=./emulator-data --export-on-exit",
    "test:rules": "firebase emulators:exec --project demo-foodweb --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "seed": "node scripts/seed.ts",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
