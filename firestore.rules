rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Admin allowlist (Firebase Auth UIDs). Keep in sync with storage.rules;
    // a test fails if the two lists differ.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['3gkTTn7yh8e8mneFegE0IigyhWk2'];
    }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isInt(v, min, max) {
      return v is int && v >= min && v <= max;
    }

    function isList(v, maxItems) {
      return v is list && v.size() <= maxItems;
    }

    // ---------- Recipes ----------

    function isValidRecipe(recipeId, d) {
      return d.keys().hasOnly([
          'title', 'description', 'photoPath', 'photoUrl', 'prepMinutes', 'cookMinutes',
          'servings', 'ingredients', 'steps', 'tags', 'categoryId', 'notes', 'status',
          'featured', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.keys().hasAll([
          'title', 'description', 'photoPath', 'photoUrl', 'prepMinutes', 'cookMinutes',
          'servings', 'ingredients', 'steps', 'tags', 'categoryId', 'notes', 'status',
          'featured', 'createdAt', 'updatedAt', 'publishedAt'])
        && isStr(d.title, 1, 120)
        && isStr(d.description, 0, 2000)
        && (d.photoPath == null || (d.photoPath is string && d.photoPath.matches('recipes/' + recipeId + '/[^/]{1,100}')))
        && (d.photoUrl == null || isStr(d.photoUrl, 1, 2000))
        && isInt(d.prepMinutes, 0, 10000)
        && isInt(d.cookMinutes, 0, 10000)
        && isInt(d.servings, 1, 100)
        && isList(d.ingredients, 150)
        && isList(d.steps, 100)
        && isList(d.tags, 30)
        && (d.categoryId == null || isStr(d.categoryId, 1, 100))
        && isStr(d.notes, 0, 5000)
        && d.status in ['draft', 'published']
        && d.featured is bool
        && d.updatedAt == request.time
        && (d.publishedAt == null || d.publishedAt is timestamp);
    }

    match /recipes/{recipeId} {
      // Public queries must filter on status == 'published'.
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin()
        && isValidRecipe(recipeId, request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && isValidRecipe(recipeId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ---------- Tags & categories ----------

    function isValidLabel(d) {
      return d.keys().hasOnly(['name']) && d.keys().hasAll(['name']) && isStr(d.name, 1, 40);
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidLabel(request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidLabel(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- Curated menus (unlisted, shared by link) ----------

    function isValidMenu(d) {
      return d.keys().hasOnly(['title', 'date', 'message', 'courses', 'active', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'date', 'message', 'courses', 'active', 'createdAt', 'updatedAt'])
        && isStr(d.title, 1, 120)
        && (d.date == null || (d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && isStr(d.message, 0, 2000)
        && d.courses is map
        && d.courses.keys().hasOnly(['appetizer', 'main', 'dessert', 'drinks'])
        && d.courses.keys().hasAll(['appetizer', 'main', 'dessert', 'drinks'])
        && isList(d.courses.appetizer, 20)
        && isList(d.courses.main, 20)
        && isList(d.courses.dessert, 20)
        && isList(d.courses.drinks, 20)
        && d.active is bool
        && d.updatedAt == request.time;
    }

    // A copy of a recipe stored with the menu, so drafts can be shared
    // through a menu without becoming public.
    function isValidRecipeSnapshot(d) {
      return d.keys().hasOnly([
          'title', 'description', 'photoUrl', 'prepMinutes', 'cookMinutes', 'servings',
          'ingredients', 'steps', 'notes'])
        && d.keys().hasAll([
          'title', 'description', 'photoUrl', 'prepMinutes', 'cookMinutes', 'servings',
          'ingredients', 'steps', 'notes'])
        && isStr(d.title, 1, 120)
        && isStr(d.description, 0, 2000)
        && (d.photoUrl == null || isStr(d.photoUrl, 1, 2000))
        && isInt(d.prepMinutes, 0, 10000)
        && isInt(d.cookMinutes, 0, 10000)
        && isInt(d.servings, 1, 100)
        && isList(d.ingredients, 150)
        && isList(d.steps, 100)
        && isStr(d.notes, 0, 5000);
    }

    function menuIsActive(menuId) {
      return get(/databases/$(database)/documents/menus/$(menuId)).data.active == true;
    }

    match /menus/{menuId} {
      // Anyone with the link can open an active menu, but only the admin can
      // list menus, so links can't be discovered.
      allow get: if isAdmin() || resource.data.active == true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidMenu(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && isValidMenu(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();

      match /recipes/{recipeId} {
        allow read: if isAdmin() || menuIsActive(menuId);
        allow create, update: if isAdmin() && isValidRecipeSnapshot(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    // ---------- Community menus (potlucks, shared by link) ----------

    function isValidCommunityMenu(d) {
      return d.keys().hasOnly([
          'title', 'eventDate', 'description', 'courses', 'active', 'locked', 'createdAt', 'updatedAt'])
        && d.keys().hasAll([
          'title', 'eventDate', 'description', 'courses', 'active', 'locked', 'createdAt', 'updatedAt'])
        && isStr(d.title, 1, 120)
        && (d.eventDate == null
          || (d.eventDate is string && d.eventDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && isStr(d.description, 0, 2000)
        && d.courses is list && d.courses.size() >= 1 && d.courses.size() <= 12
        && d.active is bool
        && d.locked is bool
        && d.updatedAt == request.time;
    }

    function communityMenu(menuId) {
      return get(/databases/$(database)/documents/communityMenus/$(menuId)).data;
    }

    // Open for sign-ups: link on and not locked.
    function isOpenForEntries(menuId) {
      let menu = communityMenu(menuId);
      return menu.active == true && menu.locked == false;
    }

    function isValidEntry(menuId, d) {
      return d.keys().hasOnly([
          'uid', 'displayName', 'course', 'dishName', 'description', 'link', 'recipeText',
          'createdAt', 'updatedAt'])
        && d.keys().hasAll([
          'uid', 'displayName', 'course', 'dishName', 'description', 'link', 'recipeText',
          'createdAt', 'updatedAt'])
        && isStr(d.displayName, 1, 50)
        && isStr(d.dishName, 1, 100)
        && isStr(d.description, 0, 500)
        && (d.link == null || (isStr(d.link, 1, 500) && d.link.matches('https?://[^ ]+')))
        && (d.recipeText == null || isStr(d.recipeText, 1, 5000))
        && d.course in communityMenu(menuId).courses
        && d.updatedAt == request.time;
    }

    match /communityMenus/{menuId} {
      // Like curated menus: open by link, never listable except by the admin.
      allow get: if isAdmin() || resource.data.active == true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidCommunityMenu(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && isValidCommunityMenu(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();

      match /entries/{entryId} {
        // Everyone with the link can see what's been claimed.
        allow read: if isAdmin() || communityMenu(menuId).active == true;

        // Signed-in contributors add dishes under their own UID.
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && isOpenForEntries(menuId)
          && isValidEntry(menuId, request.resource.data)
          && request.resource.data.createdAt == request.time;

        // Contributors edit only their own dishes, and only while sign-ups are open.
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && isOpenForEntries(menuId)
          && isValidEntry(menuId, request.resource.data);

        // The admin can remove anything, any time.
        allow delete: if isAdmin()
          || (request.auth != null
            && resource.data.uid == request.auth.uid
            && isOpenForEntries(menuId));
      }
    }

    // Everything else is denied by default.
  }
}
