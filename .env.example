# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
# These values are not secret (they ship in the browser bundle) but we keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated admin UIDs. Only used to show/hide admin UI;
# the real enforcement lives in firestore.rules and storage.rules.
VITE_ADMIN_UIDS=

# "true" connects the app to the local Firebase emulators instead of production.
VITE_USE_EMULATORS=true
